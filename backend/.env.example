# 1st Class Express Transport API Environment Configuration
NODE_ENV=staging
PORT=8080
JWT_SECRET=replace-with-at-least-32-random-bytes-from-your-secret-manager
CORS_ORIGIN=https://replace-with-staging-dispatcher.example.invalid
LOG_LEVEL=info
DATABASE_URL=postgresql://replace-with-secret-manager-reference
DB_POOL_SIZE=10
IDEMPOTENCY_TTL_MS=86400000
TELEMETRY_RETENTION_DAYS=
TELEMETRY_MAX_POINTS=500000

# Private S3-compatible object storage. Credentials must come from the runtime secret manager.
OBJECT_STORAGE_BUCKET=replace-with-private-bucket
OBJECT_STORAGE_REGION=ap-southeast-2
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PREFIX=evidence/
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Firebase Cloud Messaging (FCM)
FCM_PROJECT_ID=replace-with-firebase-project-id
FCM_CLIENT_EMAIL=replace-with-firebase-service-account-email
FCM_PRIVATE_KEY=""

{
  "name": "1stclass-transport-api",
  "version": "1.0.0",
  "description": "1st Class Express Transport Management API & Realtime Dispatch Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --runInBand --detectOpenHandles",
